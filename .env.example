# Environment Configuration for Probosque System
COMPOSE_PROJECT_NAME=probosque

# Database (PostgreSQL + PostGIS)
POSTGRES_USER=probosque
POSTGRES_PASSWORD=probosque_secret_2026
POSTGRES_DB=probosque_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://probosque:probosque_secret_2026@localhost:5432/probosque_db
SYNC_DATABASE_URL=postgresql+psycopg2://probosque:probosque_secret_2026@localhost:5432/probosque_db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=probosque_admin
MINIO_ROOT_PASSWORD=probosque_minio_pass_2026
MINIO_BUCKET_NAME=probosque-evidence
MINIO_USE_SSL=false

# Application Security
SECRET_KEY=probosque_super_secret_jwt_key_development_only_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Methodology & Versioning
METHODOLOGY_VERSION=SAMPLING-1.0
CALCULATOR_VERSION=CALC-1.0
RULES_VERSION=RULES-1.0
TRIAGE_METHODOLOGY_VERSION=TRIAGE-1.0
CARBON_METHODOLOGY_VERSION=CARBON-1.0

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
DOCS_PORT=8008
NGINX_PORT=8080
ORQUESTADOR_PORT=8010
CONVOCATORIAS_PORT=8011
EXPEDIENTE_DIGITAL_PORT=8012
DICTAMINACION_PORT=8013
FORMALIZACION_SEGUIMIENTO_PORT=8014
METRICAS_CIERRE_PORT=8015

# Bases del trámite. Cada servicio tiene la suya. No usar estas credenciales para el visor.
FEPI_DB_PASSWORD=fepi_dev_2026
# Fecha con la que se prueban las reglas. Si se omite, el orquestador usa el reloj y lo declara.
# FECHA_OPERACION=2026-03-15
